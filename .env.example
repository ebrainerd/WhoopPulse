# ---------------------------------------------------------------------------
# Whoop Recovery Journal — environment variables
# Copy this file to `.env` and fill in your values.
# Anything prefixed with EXPO_PUBLIC_ is embedded in the client bundle.
# Whoop / service secrets live ONLY in Supabase Edge Function secrets.
# ---------------------------------------------------------------------------

# Supabase (Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Whoop OAuth client id (public). Create an app at https://developer.whoop.com
EXPO_PUBLIC_WHOOP_CLIENT_ID=YOUR-WHOOP-CLIENT-ID

# Default location used for weather + onboarding seed (Hermosa Beach, CA)
EXPO_PUBLIC_DEFAULT_LAT=33.8622
EXPO_PUBLIC_DEFAULT_LNG=-118.3995
EXPO_PUBLIC_DEFAULT_LOCATION_NAME=Hermosa Beach, CA

# ---------------------------------------------------------------------------
# The following are NOT used by the app bundle. Set them as Supabase secrets:
#   supabase secrets set WHOOP_CLIENT_ID=... WHOOP_CLIENT_SECRET=... WHOOP_REDIRECT_URI=...
# ---------------------------------------------------------------------------
# WHOOP_CLIENT_ID=
# WHOOP_CLIENT_SECRET=
# WHOOP_REDIRECT_URI=whooprj://whoop-callback
